# Copy to .env. Keep the production secret private.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional upload cap in bytes (default 104857600 = 100 MiB)
PAPYRONIX_MAX_UPLOAD_BYTES=104857600
# Optional: place SQLite and retained private document uploads outside the code directory.
# PAPYRONIX_DATA_DIR=./data
# Production HTTPS switches (leave defaults in local development).
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
DJANGO_HSTS_SECONDS=0

# Optional: set a PostgreSQL URL for production. Leave blank for local SQLite.
DATABASE_URL=
DJANGO_CSRF_TRUSTED_ORIGINS=
